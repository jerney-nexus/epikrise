{
  "name": "Epikrise",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/desktop-lite:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/devcontainers-extra/features/pnpm:2": {
      "version": "12.8.1"
    },
    "ghcr.io/devcontainers-extra/features/cmake:1": {},
    "ghcr.io/devcontainers-extra/features/curl-apt-get:1": {},
    "ghcr.io/devcontainers-extra/features/wget-apt-get:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {},
    "ghcr.io/devcontainers-extra/features/prettier:1": {
      "version": "3.9.9"
    },
    "ghcr.io/devcontainers-extra/features/actionlint:1": {},
    "ghcr.io/devcontainers-extra/features/graphite-cli:1": {}
  },
  "onCreateCommand": "bash .devcontainer/install-deps.sh",
  "postCreateCommand": "bash .devcontainer/setup-agent-config.sh && sudo install -d -o vscode -g vscode -m 0700 /home/vscode/.local/share/gh /home/vscode/.local/share/graphite /home/vscode/.local/share/ssh && pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium firefox webkit && node --input-type=module -e 'await import(\"vite\"); console.log(\"Vite native binding ready\")'",
  "forwardPorts": [1420, 6080, 9323],
  "portsAttributes": {
    "1420": {
      "label": "Vite dev server",
      "onAutoForward": "silent"
    },
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "notify"
    },
    "9323": {
      "label": "Playwright Inspector",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "DISPLAY": ":1",
    "GH_CONFIG_DIR": "/home/vscode/.local/share/gh",
    "PLAYWRIGHT_CROSS_BROWSER": "1",
    // WebKitGTK's DMABUF renderer fails inside a container without GPU passthrough.
    "WEBKIT_DISABLE_DMABUF_RENDERER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "svelte.svelte-vscode",
        "tauri-apps.tauri-vscode",
        "rust-lang.rust-analyzer",
        "ryanluker.vscode-coverage-gutters",
        "ms-playwright.playwright",
        "tamasfe.even-better-toml",
        "vitest.explorer",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "graphite.gti-vscode"
      ],
      "settings": {
        "chat.permissions.default": "default",
        "chat.defaultConfiguration": {
          "mode": "interactive",
          "approvals": "manual"
        },
        "chat.tools.global.autoApprove": false,
        "chat.assistedPermissions.enabled": false,
        "chat.autopilot.advanced.enabled": false,
        "chat.tools.eligibleForAutoApproval": {
          "add_comment_to_pending_review": false,
          "add_issue_comment": false,
          "add_reply_to_pull_request_comment": false,
          "assign_copilot_to_issue": false,
          "create_branch": false,
          "create_or_update_file": false,
          "create_pull_request": false,
          "create_pull_request_with_copilot": false,
          "create_repository": false,
          "delete_file": false,
          "fork_repository": false,
          "issue_write": false,
          "merge_pull_request": false,
          "pull_request_review_write": false,
          "push_files": false,
          "request_copilot_review": false,
          "resolveReviewThread": false,
          "sub_issue_write": false,
          "update_issue_comment": false,
          "update_pull_request": false,
          "update_pull_request_branch": false,
          "installExtension": false,
          "installExtensions": false,
          "runCommand": false,
          "createAndRunTask": false,
          "runTask": false
        },
        "chat.tools.edits.autoApprove": {
          "**/*": true,
          "**/.env*": false,
          "**/*.{key,pem,p12,pfx}": false,
          "**/.vscode/**": false,
          "**/.devcontainer/**": false,
          "**/.github/**": false,
          "**/AGENTS.md": false,
          "**/CLAUDE.md": false,
          "**/SKILL.md": false,
          "**/*.{instructions,prompt,agent}.md": false,
          "**/policy*.toml": false,
          "**/package.json": false,
          "**/pnpm-lock.yaml": false,
          "**/pnpm-workspace.yaml": false,
          "**/Cargo.toml": false,
          "**/Cargo.lock": false,
          "**/scripts/**": false
        },
        "chat.tools.urls.autoApprove": {
          "https://code.visualstudio.com": {
            "approveRequest": true,
            "approveResponse": false
          },
          "https://github.com/microsoft/vscode/wiki/*": {
            "approveRequest": true,
            "approveResponse": false
          },
          "https://code.visualstudio.com/docs/*": {
            "approveRequest": true,
            "approveResponse": false
          },
          "https://v2.tauri.app/*": {
            "approveRequest": true,
            "approveResponse": false
          },
          "https://svelte.dev/docs/*": {
            "approveRequest": true,
            "approveResponse": false
          },
          "https://doc.rust-lang.org/*": {
            "approveRequest": true,
            "approveResponse": false
          },
          "https://playwright.dev/docs/*": {
            "approveRequest": true,
            "approveResponse": false
          }
        },
        "chat.agent.sandbox.enabled": "off",
        "chat.agent.sandbox.allowAutoApprove": false,
        "chat.agent.sandbox.allowUnsandboxedCommands": false,
        "chat.agent.sandbox.allowNetwork": false,
        "chat.agent.sandbox.fileSystem.linux": {
          "denyRead": [
            "/home/vscode/.ssh",
            "/home/vscode/.local/share/ssh",
            "/home/vscode/.copilot-host",
            "/home/vscode/.claude-host"
          ]
        },
        "chat.agent.allowedNetworkDomains": [
          "api.github.com",
          "github.com",
          "index.crates.io",
          "static.crates.io",
          "registry.npmjs.org"
        ],
        "chat.agent.deniedNetworkDomains": [],
        "chat.tools.terminal.enableAutoApprove": true,
        "chat.tools.terminal.autoApproveWorkspaceNpmScripts": false,
        "chat.tools.terminal.ignoreDefaultAutoApproveRules": false,
        "chat.tools.terminal.blockDetectedFileWrites": "outsideWorkspace",
        "chat.tools.terminal.autoApprove": {
          "/^pnpm (?:run )?(?:dev|build|preview|check(?::(?:ui|watch|rust(?::(?:fmt|clippy|deny))?))?|lint(?::actions)?|test(?::(?:coverage|e2e(?::report)?|a11y|i18n|ui(?::coverage)?|rust(?::(?:coverage|package|updater))?))?|format:check(?::file)?|audit:(?:rust|pnpm))(?:\\s|$)/": true,
          "/^git (?:status|diff|show|log|blame|ls-files|ls-tree|rev-parse)(?:\\s|$)/": true,
          "/^git remote(?: -v)?\\s*$/": true,
          "/^git(?:\\s+(?:-C\\s+\\S+|--no-pager))*\\s+branch --show-current\\s*$/": true,
          "/^git(?:\\s+(?:-C\\s+\\S+|--no-pager))*\\s+branch(?! --show-current\\s*$)(?:\\s|$)/": false,
          "/^gh (?:--version|status|auth status|repo view|pr (?:list|view|diff|checks|status)|issue (?:list|view|status)|run (?:list|view|watch)|workflow (?:list|view)|release (?:list|view)|search (?:code|commits|issues|prs|repos)|label list|project (?:list|view))(?:\\s|$)/": true,
          "/^gh auth status(?:\\s+.*)?--show-token(?:\\s|$)/": false,
          "/^gh (?:api|auth (?:login|logout|refresh|setup-git|switch|token)|pr (?:checkout|create|edit|merge|close|reopen|review|comment)|issue (?:create|edit|close|reopen|delete|comment)|run (?:cancel|delete|rerun)|workflow (?:run|enable|disable)|release (?:create|edit|delete|upload)|repo (?:clone|create|delete|edit|fork))(?:\\s|$)/": false,
          "/^pnpm (?:run )?audit:pnpm(?:\\s+.*)?--fix(?:=\\S+)?(?:\\s|$)/": false,
          "/^pnpm (?:run )?(?:build:all|release:prepare|template:convert|windows:(?:setup|build(?::(?:x64|arm64))?)|install|add|remove|update|exec|dlx|publish)(?:\\s|$)/": false,
          "/^git (?:add|commit|push|reset|clean|checkout|switch|restore|rebase|merge|cherry-pick|revert)(?:\\s|$)/": false
        }
      }
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=epikrise-gh-auth-${devcontainerId},target=/home/vscode/.local/share/gh,type=volume,volume-nocopy",
    "source=epikrise-graphite-auth-${devcontainerId},target=/home/vscode/.local/share/graphite,type=volume,volume-nocopy",
    "source=epikrise-ssh-${devcontainerId},target=/home/vscode/.local/share/ssh,type=volume,volume-nocopy",
    // Host agent configuration is staged read-only; setup-agent-config.sh
    // symlinks selected entries into the writable CLI homes below.
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.copilot,target=/home/vscode/.copilot-host,type=bind,readonly,bind-create-src",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude-host,type=bind,readonly,bind-create-src",
    // Writable homes: Copilot CLI and Claude Code keep runtime/session state here.
    "source=epikrise-copilot-home-${devcontainerId},target=/home/vscode/.copilot,type=volume",
    "source=epikrise-claude-home-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ]
}
