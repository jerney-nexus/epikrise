{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epikrise",
  "version": "0.1.0",
  "identifier": "com.pascaljerney.epikrise",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Epikrise",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/tesseract"],
    "resources": [
      "resources/ocr/pdfium/libpdfium.so",
      "resources/ocr/tessdata/*.traineddata"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
