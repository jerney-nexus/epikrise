{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "tesseract",
          "cmd": "binaries/tesseract",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
